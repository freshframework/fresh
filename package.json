{
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "GOMAXPROCS=1 tsgo -p src --noEmit && GOMAXPROCS=1 tsgo -p example --noEmit && GOMAXPROCS=1 tsgo -p tests/fixture --noEmit && GOMAXPROCS=1 tsgo -p www --noEmit",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run build && pnpm run typecheck",
    "dev": "pnpm --filter fresh-example run dev",
    "www": "pnpm --filter fresh-www run dev",
    "www:build": "pnpm --filter fresh-www run build",
    "www:preview": "pnpm --filter fresh-www run preview",
    "bump-version:alpha": "pnpm version --filter=@frsh/* $(node -p 'const now = Temporal.Now.zonedDateTimeISO().withTimeZone(\"UTC\"); `3.0.0-alpha.${now.year}${String(now.month).padStart(2, \"0\")}${String(now.day).padStart(2, \"0\")}${String(now.hour).padStart(2, \"0\")}${String(now.minute).padStart(2, \"0\")}`')"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "fresh": "workspace:@frsh/fresh@*",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.8.0"
}

{
  "name": "@frsh/fresh",
  "version": "3.0.0-alpha.202610031718",
  "private": false,
  "description": "The framework so simple, you already know it.",
  "keywords": [
    "file-system-routing",
    "fresh",
    "islands",
    "preact",
    "ssr",
    "vite",
    "web-framework"
  ],
  "homepage": "https://usefresh.dev",
  "bugs": {
    "url": "https://github.com/freshframework/fresh/issues"
  },
  "license": "MIT",
  "author": "the Fresh authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freshframework/fresh.git",
    "directory": "src"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./entrypoints/index.ts",
    "./vite": "./entrypoints/vite.ts",
    "./types": "./entrypoints/types.ts",
    "./errors": "./entrypoints/errors.ts",
    "./signals": "./entrypoints/signals.ts",
    "./serializable": "./entrypoints/serializable.ts",
    "./events": "./entrypoints/events.ts",
    "./runtime": "./entrypoints/runtime.ts",
    "./internal/server": "./entrypoints/internal/server.ts",
    "./internal/client": "./entrypoints/internal/client.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/entrypoints/index.d.ts",
        "default": "./dist/entrypoints/index.js"
      },
      "./vite": {
        "types": "./dist/entrypoints/vite.d.ts",
        "default": "./dist/entrypoints/vite.js"
      },
      "./types": {
        "types": "./dist/entrypoints/types.d.ts",
        "default": "./dist/entrypoints/types.js"
      },
      "./errors": {
        "types": "./dist/entrypoints/errors.d.ts",
        "default": "./dist/entrypoints/errors.js"
      },
      "./signals": {
        "types": "./dist/entrypoints/signals.d.ts",
        "default": "./dist/entrypoints/signals.js"
      },
      "./serializable": {
        "types": "./dist/entrypoints/serializable.d.ts",
        "default": "./dist/entrypoints/serializable.js"
      },
      "./events": {
        "types": "./dist/entrypoints/events.d.ts",
        "default": "./dist/entrypoints/events.js"
      },
      "./runtime": {
        "types": "./dist/entrypoints/runtime.d.ts",
        "default": "./dist/entrypoints/runtime.js"
      },
      "./internal/server": {
        "types": "./dist/entrypoints/internal/server.d.ts",
        "default": "./dist/entrypoints/internal/server.js"
      },
      "./internal/client": {
        "types": "./dist/entrypoints/internal/client.d.ts",
        "default": "./dist/entrypoints/internal/client.js"
      }
    }
  },
  "scripts": {
    "build": "GOMAXPROCS=1 tsgo -p tsconfig.json && find dist -name '*.test.*' -delete && cp -R vendor dist/vendor",
    "prepack": "rm -rf dist && pnpm run build"
  },
  "dependencies": {
    "@prefresh/vite": "^4.0.1",
    "magic-string": "^1.4.2",
    "nitro": "^3.0.260903-beta",
    "preact-render-to-string": "^6.8.0",
    "rolldown": "^1.2.12",
    "rou3": "^0.11.0",
    "srvx": "^1.0.5"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.152.0",
    "@preact/signals": "^2.11.3",
    "@types/node": "^26.6.4",
    "preact": "^11.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@preact/signals": "^2",
    "preact": "^11",
    "vite": "^8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
